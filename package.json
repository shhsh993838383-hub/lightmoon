{
  "name": "lightmoon-movie-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "node --use-env-proxy --watch server/index.mjs",
    "start": "node --use-env-proxy server/index.mjs",
    "kb:build": "node server/build-knowledge.mjs",
    "tmdb:sync": "node --use-env-proxy scripts/sync-tmdb.mjs",
    "tmdb:all": "node --use-env-proxy scripts/import-all-tmdb.mjs",
    "test": "node --test server/tests/*.test.mjs",
    "cf:dev": "wrangler dev --local --port 8790",
    "cf:seed": "node scripts/prepare-d1-seed.mjs",
    "cf:deploy": "wrangler deploy",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prebuild": "node scripts/prepare-static-catalog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.2.0",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": "24.x"
  }
}
